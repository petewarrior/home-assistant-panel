import { Measurements, Colors, Palette, Style } from "../common.slint";
import { FancySlider } from "general/fancySlider.slint";
import { Control } from "control.slint";
import { AppState } from "../appState.slint";
import { HaText } from "general/haText.slint";


export component Lamp inherits Control {
    in property <length> tilePadding: (root.height > Measurements.small-height-tile) ? 18px : 9px;
    in property <bool> home-assistant-controlled: false;
    in property <bool> home-assistant-on: false;
    in property <bool> home-assistant-dimmable: false;
    in property <float> home-assistant-brightness: 255;
    in property <bool> home-assistant-color-capable: false;
    callback home-assistant-open-color-picker();
    callback home-assistant-toggle(bool);
    callback home-assistant-brightness-change(float);

    show-label: false;
    tile-shadow-blur: 0px;

    function sync-home-assistant-state() {
        slider.anim-duration = 200ms;
        slider.animated-value = root.home-assistant-on
            ? root.home-assistant-brightness * slider.maxValue / 255
            : 0;
        if root.home-assistant-on {
            root.saved-value = slider.animated-value;
        }
    }

    changed home-assistant-on => {
        if root.home-assistant-controlled {
            root.sync-home-assistant-state();
        }
    }

    changed home-assistant-brightness => {
        if root.home-assistant-controlled && root.home-assistant-dimmable {
            root.sync-home-assistant-state();
        }
    }

    init => {
        if root.home-assistant-controlled {
            root.sync-home-assistant-state();
        }
    }

    property <bool> is-dragging: false;
    property <length> drag-threshold: 5px;
    property <float> saved-value: 22;
    property <float> drag-min-value: 5;

    tile := Rectangle {
        width: 100%;
        height: 100%;

        Rectangle {
            x: tile.width - self.width + 20px;
            width: 70%;
            height: 100%;

            Image {
                y: 0;
                source: @image-url("../images/lamp/0000.png");
            }
            Image {
                y: 0;
                source: @image-url("../images/lamp/0024.png");
                opacity: slider.animated-value / slider.maxValue;
            }

            TouchArea {
                enabled: root.home-assistant-controlled;
                width: 100%;
                height: parent.height - slider.height * 2 - tilePadding;
                clicked => {
                    AppState.end-kiosk-mode();
                    root.home-assistant-toggle(!root.home-assistant-on);
                }
            }
        }

        v := VerticalLayout {
            padding: tilePadding;
            width: 100%;
            height: 100%;
            alignment: space-between;
            HaText {
                text: root.name;
                font-size: Style.tile-title-font-size;
                font-weight: FontWeight.extra-light;
                color: white;
            }

            if root.home-assistant-controlled && root.home-assistant-color-capable: Rectangle {
                width: 76px;
                height: 26px;
                border-radius: 13px;
                background: Palette.control-alternate-background;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 6px;

                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: @linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
                    }

                    HaText {
                        text: "Color";
                        color: Palette.control-foreground;
                        font-size: 11px;
                    }
                }

                TouchArea {
                    clicked => {
                        AppState.end-kiosk-mode();
                        root.home-assistant-open-color-picker();
                    }
                }
            }

            slider := FancySlider {
                maxValue: 24;
                value: 22;
                visible: !root.home-assistant-controlled || root.home-assistant-dimmable;
                interactive: !root.home-assistant-controlled || root.home-assistant-dimmable;
                width: root.width * 0.8;
                icon: @image-url("../images/brightness.svg");
                colorize-icon: Colors.black;
                user-value-changed(value) => {
                    if root.home-assistant-controlled && root.home-assistant-dimmable {
                        root.home-assistant-brightness-change(value * 255 / self.maxValue);
                    }
                }
            }
        }
    }
    TouchArea {
        enabled: !root.home-assistant-controlled;
        clicked => {
            AppState.end-kiosk-mode();
            if !root.is-dragging {
                slider.anim-duration = 300ms;
                if slider.value > 0 {
                    root.saved-value = slider.value;
                    slider.animated-value = 0;
                } else {
                    slider.animated-value = root.saved-value;
                }
            }
        }
        moved => {
            if !root.home-assistant-controlled {
                if !slider.first-touch {
                    slider.first-touch = true;
                    slider.initial-position = self.mouse-x;
                    slider.initial-value = (self.mouse-x / self.width) * (slider.maxValue - slider.minValue) + slider.minValue;
                    slider.previous-value = slider.value;
                    slider.anim-duration = 0ms;
                } else {
                    if Math.abs(self.mouse-x - slider.initial-position) > root.drag-threshold {
                        root.is-dragging = true;
                    }

                    if root.is-dragging {
                        slider.change-value = ((self.mouse-x / self.width) * (slider.maxValue - slider.minValue) + slider.minValue) - slider.initial-value;
                        slider.value = Math.clamp(slider.previous-value + slider.change-value, root.drag-min-value, slider.maxValue);
                        slider.animated-value = slider.value;
                        root.saved-value = slider.value;
                    }
                }
            }
        }

        changed pressed => {
            if !self.pressed {
                slider.first-touch = false;
                root.is-dragging = false;
            }
        }
    }
}
